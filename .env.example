# Gemini API Keys for Multi-Key Rotation Manager (Flash model)
# AI Studio automatically injects GEMINI_API_KEY; keys 1, 2, and 3 provide automatic failover and load rotation.
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_API_KEY_1="your-first-gemini-key-here"
GEMINI_API_KEY_2="your-second-gemini-key-here"
GEMINI_API_KEY_3="your-third-gemini-key-here"

# Administrator demonstration password
ADMIN_PASSWORD="your-admin-password-here"

# Optional YouTube Data API v3 key (fallback search links provided if absent)
YOUTUBE_API_KEY="your-youtube-api-key-here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5173"

